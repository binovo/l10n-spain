<odoo>

    <menuitem name="Verifactu"
              parent="account.menu_finance"
              id="menu_account_l10n_es_edi_verifactu"
              groups="account.group_account_manager"/>

    <record id="view_account_edi_document_verifactu_search" model="ir.ui.view">
        <field name="name">view.account.edi.document.verifactu.search</field>
        <field name="model">account.edi.document</field>
        <field name="arch" type="xml">
            <search>
               <filter string="Error"
                        name="error"
                        domain="[('verifactu_state','=','error')]"
               />
            </search>
        </field>
    </record>

    <record id="view_tree_account_edi_document_verifactu" model="ir.ui.view">
        <field name="name">view.tree.account.edi.document.verifactu</field>
        <field name="model">account.edi.document</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" edit="false"
                  decoration-info="blocking_level == 'info'"
                  decoration-warning="blocking_level == 'warning'"
                  decoration-danger="blocking_level in ['error']">
                <field name="create_date"/>
                <field name="move_id" string="Invoice"/>
                <field name="name" groups="base.group_no_one"/>
                <field name="verifactu_state" string="Status"/>
                <field name="state" string="Sending Status" groups="base.group_no_one"/>
                <field name="error"/>
                <field name="blocking_level" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="action_account_edi_document_es_verifactu" model="ir.actions.act_window">
        <field name="name">Verifactu EDI Documents</field>
        <field name="res_model">account.edi.document</field>
        <field name="view_id" ref="l10n_es_edi_verifactu.view_tree_account_edi_document_verifactu"/>
        <field name="view_mode">tree</field>
        <field name="domain">[('edi_format_id.code', '=', 'es_verifactu')]</field>
    </record>

    <menuitem name="AEAT Queue"
              parent="menu_account_l10n_es_edi_verifactu"
              id="menu_account_l10n_es_edi_document_verifactu"
              action="l10n_es_edi_verifactu.action_account_edi_document_es_verifactu"
              groups="account.group_account_manager"/>

    <record model="ir.actions.server" id="server_action_open_legal_declaration">
        <field name="name">Verifactu legal declaration</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_account_move"/>
        <field name="state">code</field>
        <field name="code">
if env.company.l10n_es_verifactu_legal_file:
    action = {
        "type": "ir.actions.act_url",
        "url": '/web/content/res.company/%s/l10n_es_verifactu_legal_file?download=true&amp;filename_field=l10n_es_verifactu_legal_file_filename' % env.company.id,
        "target": 'self'
    }
else:
    action = {
        "type": "ir.actions.act_url",
        "url": '/l10n_es_edi_verifactu/static/doc/Declaracion_responsable_sistema_informatico_verifactu_odoo.docx',
        "target": 'self'
    }
        </field>
    </record>

    <menuitem name="Download legal declaration"
              parent="menu_account_l10n_es_edi_verifactu"
              id="menu_verifactu_legal_declaration"
              action="l10n_es_edi_verifactu.server_action_open_legal_declaration"
              groups="account.group_account_manager"/>

</odoo>
