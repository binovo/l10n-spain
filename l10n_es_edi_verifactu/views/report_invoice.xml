<odoo>
    <template id="verifactu_qr">
        <div class="col-4 verifactu-qr" t-if="o.l10n_es_verifactu_is_in_chain()">
            <div class="row text-center">
                <div class="w-100">
                    <strong>QR Tributario:</strong>
                </div>
            </div>
            <div id="l10n_es_verifactu_qr" class="row text-center">
                <div class="mb8 w-100">
                    <img
                        t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;barLevel=%s'%('QR', quote_plus(o.l10n_es_edi_verifactu_qr_url), 125, 125, 'M')"/>
                </div>
            </div>
            <div class="row text-center">
                <div class="w-100">
                    <strong>VERI*FACTU</strong>
                </div>
            </div>
        </div>
    </template>
    <template id="l10n_es_verifactu_report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('row')]//div[@name='address_same_as_shipping']//t[@t-set='address']"
               position="after">
            <t t-set="information_block">
                <t t-call="l10n_es_edi_verifactu.verifactu_qr"/>
            </t>
        </xpath>
         <xpath expr="//div[hasclass('row')]//div[@name='shipping_address_block']"
               position="before">
                <t t-call="l10n_es_edi_verifactu.verifactu_qr"/>
        </xpath>
         <xpath expr="//div[hasclass('row')]//div[@name='no_shipping']//t[@t-set='address']"
               position="after">
            <t t-set="information_block">
                <t t-call="l10n_es_edi_verifactu.verifactu_qr"/>
            </t>
        </xpath>
    </template>
    <template id="report_invoice_verifactu_adjust_shipping_address_style" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='shipping_address_block']" position="attributes">
            <attribute name="t-att-class">'verifactu-address-adjust' if o.l10n_es_verifactu_is_in_chain() else ''</attribute>
        </xpath>
    </template>
</odoo>
